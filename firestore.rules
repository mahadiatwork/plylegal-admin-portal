rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /applications/{appId} {
      // Authenticated owner access
      allow read, update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Public read only for explicitly flagged docs
      allow read: if resource.data.publicReviewAccess == true;

      // Create only by authenticated owner
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    match /applications/{appId}/{document=**} {
      // Authenticated owner access to subcollections
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/applications/$(appId)).data.userId == request.auth.uid;

      // Public read to subcollections only if parent is flagged public
      allow read: if get(/databases/$(database)/documents/applications/$(appId)).data.publicReviewAccess == true;
    }

    match /users/{userId}/preferences/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/drafts/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/zoho/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    match /messages/{messageId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.senderUid == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.senderUid == request.auth.uid;

      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.senderUid == request.auth.uid);

      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}