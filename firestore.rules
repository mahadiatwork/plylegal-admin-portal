rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /applications/{appId} {
      // Authenticated owner access
      allow read, update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Public read only for explicitly flagged docs
      allow read: if resource.data.publicReviewAccess == true;

      // Create only by authenticated owner
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    match /applications/{appId}/data/{document=**} {
      // Applicants can edit their questionnaire/completion data.
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/applications/$(appId)).data.userId == request.auth.uid;

      // Public review exposes questionnaire data, never private resources.
      allow read: if get(/databases/$(database)/documents/applications/$(appId)).data.publicReviewAccess == true;
    }

    match /applications/{appId}/resources/{resourceId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/applications/$(appId)).data.userId == request.auth.uid;
      // Matter resources are managed only by authenticated admin server APIs.
      allow write: if false;
    }

    // Client Resource Centre reads are authenticated and restricted to active
    // records. All writes use the admin portal's server APIs/Admin SDK.
    match /resources/{resourceId} {
      allow read: if request.auth != null &&
        resource.data.status == "active";
      allow write: if false;
    }

    match /resourceTemplates/{visaSlug} {
      allow read: if request.auth != null &&
        resource.data.status == "active";
      allow write: if false;

      match /items/{itemId} {
        allow read: if request.auth != null &&
          resource.data.status == "active" &&
          get(/databases/$(database)/documents/resourceTemplates/$(visaSlug)).data.status == "active";
        allow write: if false;
      }
    }

    // Published questionnaire definitions are read by authenticated applicants.
    // Admin writes normally use the server SDK, but this keeps both portal rule
    // files compatible if either project deploys the shared Firestore rules.
    match /questionnaireDefinitions/{definitionId} {
      allow read: if request.auth != null &&
        resource.data.status == "active";
      // Writes go through the admin portal's authenticated server API. The
      // Admin SDK bypasses Firestore rules, so no browser account can mutate
      // a live questionnaire directly.
      allow write: if false;

      // Backward compatibility for definitions created by the original seeder.
      match /pages/{pageId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/questionnaireDefinitions/$(definitionId)).data.status == "active";
        allow write: if false;
      }
    }

    // Immutable audit snapshots are server-only. Submitted applications retain
    // an id/revision reference even after the editable definition is deleted.
    match /questionnaireDefinitionRevisions/{revisionId} {
      allow read, write: if false;
    }

    match /users/{userId}/preferences/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/drafts/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/zoho/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    match /messages/{messageId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.senderUid == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.senderUid == request.auth.uid;

      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.senderUid == request.auth.uid);

      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
